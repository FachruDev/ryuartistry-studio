# Copy to .env / .env.local for local work, or set each one in Vercel → Settings → Environment Variables.
# Values are examples only. Never commit real values.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Asset storage (Neon object storage, S3-compatible) ---
AWS_ENDPOINT_URL_S3=https://<id>.storage.<region>.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET_PRIVATE=storage-private

# --- Dashboard login ---
STUDIO_DASHBOARD_USER=admin
STUDIO_DASHBOARD_PASSWORD=
# At least 32 random characters. Changing it signs everyone out.
STUDIO_SESSION_SECRET=

# --- Automation ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set.
CRON_SECRET=

# --- Reels ---
STUDIO_REELS_NICHE=
# Optional: paths to ffmpeg/ffprobe if they are not on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
